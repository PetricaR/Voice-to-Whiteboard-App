{
  "name": "voice-to-whiteboard-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Voice-first Live Dashboards, Programmatic Motion Explainers, Docs & Whiteboard Studio powered by Gemini Live",
  "repository": {
    "type": "git",
    "url": "https://github.com/PetricaR/Voice-to-Whiteboard-App.git",
    "directory": "studio"
  },
  "keywords": [
    "gemini",
    "gemini-live",
    "voice-ai",
    "dashboards",
    "motion-graphics",
    "nl2sql",
    "whiteboard",
    "diagrams"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "check": "tsx server/check.ts",
    "e2e": "node e2e/smoke.mjs && node e2e/live-mock.mjs && node e2e/sign-in.mjs && node e2e/export-image.mjs && node e2e/charts.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@google-cloud/firestore": "^9.4.0",
    "@material-symbols/svg-400": "^0.48.3",
    "@material/material-color-utilities": "^0.4.0",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "html-to-image": "^1.11.13",
    "hyparquet": "^1.17.1",
    "jose": "^6.2.17",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.13.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  }
}
