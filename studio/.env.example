# Loaded automatically by the studio server (never exposed to the browser bundle).
# Copy to .env and fill in your Gemini API key from https://aistudio.google.com/apikey:
GEMINI_API_KEY=

# Optional read-only server data sources. Give each one credentials that can
# only read: the SQL guard in the studio is a guardrail, not the access control.
#
# BigQuery: the default project, and more projects to offer as sources.
# BIGQUERY_PROJECT_ID=
# STUDIO_BIGQUERY_PROJECTS=project-a,project-b
# Bytes one query may scan before BigQuery refuses it (default 1 GiB).
# BIGQUERY_MAX_BYTES_BILLED=1073741824
#
# ClickHouse HTTP endpoint of a read-only user (the studio adds readonly=1).
# CLICKHOUSE_READONLY_URL=
#
# A warehouse proxy that takes POST { sql, maxRows, readOnly } and answers { columns, rows }.
# POSTGRES_HTTP_QUERY_URL=
# POSTGRES_HTTP_TOKEN=
#
# Named JSON feeds: {"crm_feed":"https://example.com/feed.json"}
# STUDIO_REST_SOURCES=
