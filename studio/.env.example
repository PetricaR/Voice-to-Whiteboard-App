# Loaded automatically by the studio server (never exposed to the browser bundle).
# Copy to .env and fill in your Gemini API key from https://aistudio.google.com/apikey:
GEMINI_API_KEY=

# Optional read-only server SQL connectors:
# BIGQUERY_PROJECT_ID=
# CLICKHOUSE_HTTP_URL=
# POSTGRES_HTTP_URL=
# REST_DATA_SOURCES=
